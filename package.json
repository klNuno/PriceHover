{
  "name": "pricehover",
  "version": "2.1.1",
  "description": "Browser extension that converts prices on hover",
  "license": "GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:firefox": "wxt build --browser firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip --browser firefox",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "icons": "bun run scripts/gen-icons.ts",
    "flags": "bun run scripts/gen-flags.ts",
    "postinstall": "wxt prepare",
    "locales": "bun run scripts/gen-locales.ts",
    "crypto:check": "bun run scripts/check-crypto-ids.ts"
  },
  "dependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "^1.1.0",
    "@types/chrome": "^0.2.2",
    "@wxt-dev/module-svelte": "^2.0.0",
    "typescript": "^5.7.0",
    "wxt": "^0.20.0"
  }
}
